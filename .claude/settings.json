{
  "permissions": {
    "allow": [
      "Read",
      "Bash(swift test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(git worktree list:*)",
      "Bash(git fetch origin)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/read-boundary.py\" || exit 2"
          }
        ]
      }
    ]
  }
}
