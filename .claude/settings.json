{
  "permissions": {
    "allow": [
      "Read",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(xcodegen generate:*)",
      "Bash(xcodebuild:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(git worktree list:*)",
      "Bash(git -c credential.helper= -c credential.helper='!gh auth git-credential' fetch https://github.com/*)",
      "Bash(git worktree add .build/review/*)",
      "Bash(git worktree remove .build/review/*)",
      "Bash(git update-ref -d refs/remotes/review/*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/read-boundary.py\""
          }
        ]
      }
    ]
  }
}
