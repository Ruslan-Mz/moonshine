{
  "permissions": {
    "allow": [
      "Bash(git -c credential.helper= -c credential.helper='!gh auth git-credential' push https://github.com/Ruslan-Mz/moonshine.git HEAD:refs/heads/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh api --method POST repos/{owner}/{repo}/pulls/*/reviews --input *)",
      "Bash(git branch -d *)",
      "Bash(git worktree prune)",
      "Bash(git update-ref -d refs/remotes/review/*)",
      "Bash(swift test *)",
      "Bash(swift build *)"
    ],
    "deny": [
      "Bash(git push *main*)",
      "Bash(git * push *main*)",
      "Bash(git push *--no-verify*)",
      "Bash(git * push *--no-verify*)",
      "Bash(git push *--delete*)",
      "Bash(git * push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git * push * -d *)",
      "Bash(git push * :*)",
      "Bash(git * push * :*)",
      "Bash(git push *--mirror*)",
      "Bash(git * push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git * push *--prune*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh api *merge*)",
      "Bash(gh api graphql *)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method put*)",
      "Bash(gh api *--method patch*)",
      "Bash(gh api *--method=*)",
      "Bash(gh api *-X *)",
      "Bash(gh repo *)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git branch *--force*)",
      "Bash(git branch -f *)",
      "Bash(git branch * -f *)"
    ],
    "ask": ["Bash(dangerouslyDisableSandbox:true)"]
  },
  "env": {
    "PATH": "/usr/bin:/bin:/usr/sbin:/sbin:/Users/<you>/.nvm/versions/node/<node-version>/bin:/opt/homebrew/bin"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "swift",
      "swift test *",
      "swift build *",
      "gh pr *",
      "gh api *",
      "git -c credential.helper= -c credential.helper='!gh auth git-credential' fetch https://github.com/Ruslan-Mz/moonshine.git *",
      "git -c credential.helper= -c credential.helper='!gh auth git-credential' push https://github.com/Ruslan-Mz/moonshine.git *"
    ],
    "filesystem": {
      "denyRead": ["~/", "/Volumes", "./data", "./deny-list.txt"],
      "allowRead": [
        ".",
        "~/.gitconfig",
        "~/.config/git/ignore",
        "~/.nvm/versions/node"
      ]
    }
  }
}
