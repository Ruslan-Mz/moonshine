{
  "permissions": {
    "allow": [
      "Bash(git fetch origin)",
      "Bash(git push origin HEAD:refs/heads/*)",
      "Bash(/Users/<you>/.config/moonshine/bin/gh-post *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(git branch -d *)",
      "Bash(git worktree prune)",
      "Bash(swift test *)",
      "Bash(swift build *)"
    ],
    "deny": [
      "Edit(./.git/config)",
      "Bash(git *fetch*--prune*)",
      "Bash(git *fetch* -p*)",
      "Bash(git *fetch*:refs/heads/*)",
      "Bash(git *fetch*:refs/tags/*)",
      "Bash(git push *main*)",
      "Bash(git * push *main*)",
      "Bash(git push *--no*)",
      "Bash(git * push *--no*)",
      "Bash(git *hooksPath*)",
      "Bash(git push *--delete*)",
      "Bash(git * push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git * push * -d *)",
      "Bash(git push * :*)",
      "Bash(git * push * :*)",
      "Bash(git push *+:*)",
      "Bash(git * push *+:*)",
      "Bash(git push *--mirror*)",
      "Bash(git * push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git * push *--prune*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr new *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr reopen *)",
      "Bash(gh issue *)",
      "Bash(gh gist *)",
      "Bash(gh release *)",
      "Bash(gh api *--method POST*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--input*)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *@*)",
      "Bash(gh api *merge*)",
      "Bash(gh api graphql *)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method put*)",
      "Bash(gh api *--method patch*)",
      "Bash(gh api *--method=*)",
      "Bash(gh api *-X*)",
      "Bash(gh repo *)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git branch *--force*)",
      "Bash(git branch -f *)",
      "Bash(git branch * -f *)"
    ],
    "ask": ["Bash(dangerouslyDisableSandbox:true)"]
  },
  "env": {
    "PATH": "/usr/bin:/bin:/usr/sbin:/sbin:/Users/<you>/.nvm/versions/node/<node-version>/bin:/opt/homebrew/bin"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "swift",
      "swift test *",
      "swift build *",
      "gh pr view *",
      "gh pr diff *",
      "gh pr checks *",
      "gh api *",
      "/Users/<you>/.config/moonshine/bin/gh-post *",
      "git fetch origin",
      "git push origin *"
    ],
    "filesystem": {
      "denyRead": ["~/", "/Volumes", "./data", "./deny-list.txt"],
      "allowRead": [
        ".",
        "~/.gitconfig",
        "~/.config/git/ignore",
        "~/.nvm/versions/node"
      ]
    }
  }
}
