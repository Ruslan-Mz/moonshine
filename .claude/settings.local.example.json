{
  "permissions": {
    "allow": [
      "Bash(git fetch origin)",
      "Bash(git push origin HEAD:refs/heads/*)",
      "Bash(/Users/<you>/.config/moonshine/bin/gh-post *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(git branch -d *)",
      "Bash(git worktree prune)",
      "Bash(swift test *)",
      "Bash(swift build *)",
      "Bash(xcodegen generate)",
      "Bash(xcodebuild -scheme MoonShineMac -destination platform=macOS,arch=arm64 -derivedDataPath DerivedData -onlyUsePackageVersionsFromResolvedFile test)",
      "Bash(xcodebuild -scheme MoonShineMac -destination platform=macOS,arch=arm64 -derivedDataPath DerivedData -onlyUsePackageVersionsFromResolvedFile build)"
    ],
    "deny": [
      "Edit(**/.git/config)",
      "Edit(**/.git/hooks/**)",
      "Edit(./.claude/hooks/**)",
      "Bash(git *fetch*--prune*)",
      "Bash(git *fetch* -p*)",
      "Bash(git *fetch*:refs/heads/*)",
      "Bash(git *fetch*:refs/tags/*)",
      "Bash(git push *main*)",
      "Bash(git * push *main*)",
      "Bash(git push *--no*)",
      "Bash(git * push *--no*)",
      "Bash(git *hooksPath*)",
      "Bash(git *hookspath*)",
      "Bash(git *HOOKSPATH*)",
      "Bash(git -c *)",
      "Bash(git -C * -c *)",
      "Bash(git *--config-env*)",
      "Bash(*GIT_CONFIG*)",
      "Bash(git *moonshine.denyList*)",
      "Bash(git *moonshine.denylist*)",
      "Bash(git push *'*)",
      "Bash(git push *\"*)",
      "Bash(git push *\\*)",
      "Bash(git push *$*)",
      "Bash(git push *--delete*)",
      "Bash(git * push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git * push * -d *)",
      "Bash(git push * :*)",
      "Bash(git * push * :*)",
      "Bash(git push *+:*)",
      "Bash(git * push *+:*)",
      "Bash(git push *--mirror*)",
      "Bash(git * push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git * push *--prune*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr new *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr reopen *)",
      "Bash(gh issue *)",
      "Bash(gh gist *)",
      "Bash(gh release *)",
      "Bash(gh api *--method POST*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--input*)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *@*)",
      "Bash(gh api *merge*)",
      "Bash(gh api graphql *)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *--method PATCH*)",
      "Bash(gh api *--method delete*)",
      "Bash(gh api *--method put*)",
      "Bash(gh api *--method patch*)",
      "Bash(gh api *--method=*)",
      "Bash(gh api *-X*)",
      "Bash(gh repo *)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git branch *--force*)",
      "Bash(git branch -f *)",
      "Bash(git branch * -f *)",
      "Bash(xcodebuild *-allowProvisioning*)",
      "Bash(xcodebuild *rchive*)",
      "Bash(xcodebuild *otariz*)"
    ],
    "ask": ["Bash(dangerouslyDisableSandbox:true)"]
  },
  "env": {
    "PATH": "/usr/bin:/bin:/usr/sbin:/sbin:/Users/<you>/.nvm/versions/node/<node-version>/bin:/opt/homebrew/bin"
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "swift",
      "swift test *",
      "swift build *",
      "xcodegen generate",
      "xcodebuild *",
      "gh pr view *",
      "gh pr diff *",
      "gh pr checks *",
      "gh api *",
      "/Users/<you>/.config/moonshine/bin/gh-post *",
      "git fetch origin",
      "git push origin *"
    ],
    "filesystem": {
      "denyRead": ["~/", "/Volumes", "./data", "./deny-list.txt"],
      "allowRead": [
        ".",
        "~/.gitconfig",
        "~/.config/git/ignore",
        "~/.nvm/versions/node"
      ]
    }
  },
  "_worktreeOnly": {
    "_note": "Only for a parallel author session's sibling worktree ../moonshine-<n>, which the owner creates (CLAUDE.md § Git). In that worktree's copy, merge these entries into permissions.deny and sandbox.filesystem, fill in the placeholders with the main checkout's path, and delete this key; in the main checkout's copy, just delete it. Never commit a real path: the owner's home path is on the deny-list.",
    "permissions": {
      "deny": [
        "Edit(//Users/<you>/<repo>/.git/config)",
        "Edit(//Users/<you>/<repo>/.git/hooks/**)"
      ]
    },
    "sandbox": {
      "filesystem": {
        "allowRead": ["<main-checkout>/.git"],
        "allowWrite": ["<main-checkout>/.git"],
        "denyWrite": ["<main-checkout>/.git/config", "<main-checkout>/.git/hooks"]
      }
    }
  }
}
