    "Quiet: an active line with no completed task for %lld days or more. Foundation, maintenance and paused lines are never quiet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet: an active line with no completed task for %lld days or more. Foundation, maintenance and paused lines are never quiet."
