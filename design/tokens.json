    "segText":       { "light": "#1D2A44", "dark": "#EDEDF0" },
    "hatch":         { "light": "rgba(0,0,0,0.22)", "dark": "rgba(255,255,255,0.22)" },
    "track":         { "light": "rgba(0,0,0,0.05)", "dark": "rgba(255,255,255,0.07)" },
    "field":         { "light": "rgba(0,0,0,0.045)", "dark": "rgba(255,255,255,0.07)" },
