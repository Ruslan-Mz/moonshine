  "type": {
    "windowTitle":   { "size": 19, "weight": "bold" },
    "screenHeader":  { "size": 24, "weight": "bold" },
    "bigNumber":     { "size": 30, "weight": "bold", "monospacedDigit": true },
    "sectionHeader": { "size": 14, "weight": "semibold" },
    "taskTitle":     { "size": 13.5, "weight": "regular" },
    "body":          { "size": 13, "weight": "regular" },
    "meta":          { "size": 12, "weight": "regular" },
