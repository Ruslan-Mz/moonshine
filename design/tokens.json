{
  "status": "draft-1",
  "note": "Custom colour tokens for the MoonShine asset catalog. Prefer system semantic colours where a role exists (text → .primary, secondary → .secondary, separators → .separator, fills → .quaternary). Values copied from the mockups' theme().",
  "color": {
    "text":          { "light": "#1D1D1F", "dark": "#EDEDF0", "system": "primary" },
    "secondary":     { "light": "#5F5F67", "dark": "#A6A6AD", "system": "secondary" },
    "tertiary":      { "light": "#74747C", "dark": "#8D8D95", "system": "tertiary" },
    "window":        { "light": "#FFFFFF", "dark": "#1E1E21", "system": "windowBackground" },
    "sidebar":       { "light": "#EFEEF2", "dark": "#28272C", "system": "sidebar material" },
    "rail":          { "light": "#F8F8FA", "dark": "#232326", "system": "inspector background" },
    "band":          { "light": "#F6F6F8", "dark": "#252528" },
